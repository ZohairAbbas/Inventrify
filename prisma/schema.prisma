generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id                 String   @id @default(cuid())
  shop               String   @unique
  courierifyApiKey   String?
  financifyApiKey    String?
  defaultLeadTime    Int      @default(7)
  // Safety stock: Z-score for service level (1.28=90%, 1.65=95%, 2.05=98%)
  serviceLevel       Float    @default(1.65)
  safetyStockDays    Int      @default(7)   // fallback when no variance data
  // Alert thresholds
  deadStockDays      Int      @default(60)
  deadStockMinUnits  Int      @default(20)
  // Notifications
  notificationEmail  String?
  slackWebhookUrl    String?
  whatsappNumber     String?
  timezone           String   @default("UTC")
  currency           String   @default("USD")
  theme              String   @default("emerald")
  // Comma-separated Shopify gateway names the merchant treats as cash-on-delivery.
  // Empty = fall back to heuristic matching (see lib/cod.server.ts).
  codGateways        String   @default("")
  // Order tag a merchant applies once a COD order has been verified (call centre /
  // WhatsApp confirmation). Shopify has no native "confirmed" state, so the convention
  // has to come from the merchant. Empty = confirmation is not tracked.
  confirmedOrderTag  String   @default("")
  // Target days of cover used when suggesting purchase-order quantities.
  coverageDays       Int      @default(30)
  // Typical round-trip days for an RTO parcel to come back and be re-shelved.
  // Returning units are scheduled as inbound supply over this window.
  rtoTransitDays     Int      @default(14)
  // Incremental cursor for the Courierify returns pull (?updatedSince=). Null = never synced.
  courierifyReturnsCursor DateTime?
  // Incremental cursor for the order-outcomes pull. Same rules as above.
  courierifyOutcomesCursor DateTime?
  // Newest courier outcome the derived RTO rates were actually computed from.
  // A courier feed can go quiet — a shop that changes carrier simply stops appearing —
  // and a stale RTO rate presented as current sizes safety stock off history.
  rtoDataThrough     DateTime?
  // Orders that contributed to the current derived RTO figures.
  rtoOrdersAttributed Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Supplier {
  id                String   @id @default(cuid())
  shop              String
  name              String
  contactName       String?
  email             String?
  phone             String?
  address           String?
  leadTimeDays      Int      @default(7)
  // Computed from PO history
  avgActualLeadTime Float?   // actual avg days from sent → received
  leadTimeVariance  Float?   // std dev (sigma) of actual lead times — derived from leadTimeM2
  // Welford's online algorithm accumulator: sum of squared deviations from the running
  // mean. sigma = sqrt(leadTimeM2 / totalPosReceived). Kept so variance stays correct
  // when POs are received one at a time.
  leadTimeM2        Float    @default(0)
  totalPosReceived  Int      @default(0)
  // Supplier minimum order value — PO suggestions top up to reach it.
  minOrderValue     Float    @default(0)
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([shop])
}

model Product {
  id              String    @id  // Shopify variant GID
  shop            String
  productGid      String          // Parent Shopify product GID
  inventoryItemId String?         // Shopify inventory_item_id — for webhook mapping
  title           String
  variantTitle    String?
  sku             String?
  // Scannable code from Shopify (EAN/UPC/Code128 as the merchant entered it). Stored so
  // receiving, counting and adjusting can be driven by a scanner rather than by typing:
  // a USB/Bluetooth scanner is a keyboard, so the whole feature is a focused input plus
  // an exact-match lookup. Nullable and frequently blank — plenty of catalogues have no
  // barcodes at all, which is why lookups fall back to SKU.
  barcode         String?
  // Variant image, falling back to the parent product's featured image. Stored so the
  // inventory, PO and returns tables can identify a SKU visually — SKU codes alone are
  // hard to tell apart across size/colour variants.
  imageUrl        String?
  currentStock    Int       @default(0)
  reorderPoint    Int       @default(0)
  leadTimeDays    Int       @default(7)
  // Resolved RTO rate used by all planning maths. Precedence is applied in
  // lib/returns-rate.server.ts: courierRtoRate (real delivery outcomes) wins over
  // estimatedRtoRate (locally inferred). Never written directly by two sources.
  codReturnRate   Float     @default(0)
  // Authoritative per-SKU RTO rate from Courierify delivery outcomes.
  courierRtoRate  Float?
  // Locally inferred fallback when Courierify is not connected.
  estimatedRtoRate Float?
  // RTO rate derived by attributing courier order outcomes to SKUs ourselves, via
  // OrderOutcome -> OrderLineItem. Used when the courier cannot report per-SKU rates
  // directly. Ranks below courierRtoRate but above estimatedRtoRate.
  derivedRtoRate  Float?
  // "courierify" | "estimated" | "none" — provenance shown in the UI.
  returnRateSource String   @default("none")
  // Pre-dispatch cancellation rate. Economically distinct from RTO: the unit never
  // left the warehouse, so it must NOT widen safety stock. Tracked separately.
  cancellationRate Float    @default(0)
  // Landed unit cost — drives inventory value, revenue-at-risk ranking and PO totals.
  unitCost        Float     @default(0)
  // Purchasing constraints applied when suggesting order quantities.
  moq             Int       @default(1)
  casePackSize    Int       @default(1)
  avgMargin       Float     @default(0)
  avgDailySales   Float     @default(0)
  // Demand/variability classification, recomputed by the planning job.
  abcClass        String?   // A | B | C by revenue contribution
  xyzClass        String?   // X | Y | Z by demand variability (CV)
  // Rolling forecast-accuracy cache (see ForecastAccuracy).
  forecastMape    Float?
  forecastBias    Float?
  // Earliest date this variant actually sold — bounds the demand-variance window so
  // new products are not padded with fake zero-demand days.
  firstSoldAt     DateTime?
  // Fulfilment pipeline — live per-SKU snapshot synced from Courierify shipment statuses.
  // Damaged is NOT here; it is derived from StockAdjustment(reason="damage"). See contract doc.
  fulfilledDelivered Int    @default(0)
  fulfilledInTransit Int    @default(0)
  fulfilledReturned  Int    @default(0)
  fulfilmentSyncedAt DateTime?
  // Which feed produced the fulfilment counts above: "courierify" | "shopify" | "none".
  // Two syncs write these fields, so without this the last cron to run simply won.
  fulfilmentSource   String   @default("none")
  // When Courierify last reported a per-SKU rate for this product. A courier feed that
  // has gone quiet must stop outranking fresh Shopify tracking, so precedence is by
  // "currently available", not merely "present".
  courierRtoSyncedAt DateTime?
  // Safety stock — auto-computed on sync
  safetyStock     Int       @default(0)
  // Soft delete. Products missing from Shopify are archived, never hard-deleted, so
  // demand history survives a partial/throttled sync.
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  forecasts        Forecast[]
  purchaseOrders   PurchaseOrderItem[]
  salesRecords     SalesRecord[]
  stockSnapshots   StockSnapshot[]
  adjustments      StockAdjustment[]
  returnRateHistory ReturnRateHistory[]
  locationStock    ProductLocationStock[]
  transferItems    StockTransferItem[]
  returnItems      ReturnItem[]
  countItems       StockCountItem[]

  forecastAccuracy ForecastAccuracy[]

  @@index([shop])
  @@index([productGid])
  @@index([inventoryItemId])
  @@index([shop, sku])
  // Exact-match lookup path for scans.
  @@index([shop, barcode])
  @@index([shop, isArchived])
}

// Physical stock locations synced from Shopify (source of truth for per-location inventory)
model Location {
  id                String   @id @default(cuid())
  shop              String
  shopifyLocationId String // Shopify location GID
  name              String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockLevels ProductLocationStock[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  stockCounts   StockCount[]

  @@unique([shop, shopifyLocationId])
  @@index([shop])
}

// Per-location stock — the real source of truth; Product.currentStock is a cached sum(onHand)
model ProductLocationStock {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Int      @default(0)
  reserved   Int      @default(0) // available = onHand - reserved
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([shop])
  @@index([locationId])
}

model SalesRecord {
  id        String   @id @default(cuid())
  shop      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime // midnight UTC
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([productId, date])
  @@index([shop, date])
}

// Daily stock snapshots for analytics / trend charts
model StockSnapshot {
  id        String   @id @default(cuid())
  shop      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime // midnight UTC
  stock     Int
  createdAt DateTime @default(now())

  @@unique([productId, date])
  @@index([shop, date])
}

// Manual inventory adjustments with audit trail
model StockAdjustment {
  id        String   @id @default(cuid())
  shop      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta      Int      // positive=added, negative=removed
  reason     String   // damage | count_correction | sample | return | other | reversal
  note       String?
  locationId String?  // Location.id this adjustment applied to (null = legacy/primary)
  // Set on a reversal row, naming the adjustment it undoes. Unique, so the database
  // itself guarantees an adjustment is reversed at most once: two clicks on "Reverse"
  // (or one double-submit) previously created two opposing movements and swung stock by
  // twice the original delta, with nothing in the audit trail to show why.
  reversalOf String?  @unique
  createdAt  DateTime @default(now())

  @@index([shop, productId])
  @@index([shop, reason])
  @@index([shop, createdAt])
}

// COD return rate per product per week (trend tracking)
model ReturnRateHistory {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  weekStart  DateTime // Monday midnight UTC
  returnRate Float    // 0.0–1.0
  orderCount Int      @default(0)   // COD units ordered this week — the denominator
  // COD units cancelled before dispatch this week. Kept beside orderCount because a
  // cancellation rate is only meaningful against the volume it is drawn from.
  cancelledUnits Int  @default(0)
  createdAt  DateTime @default(now())

  @@unique([productId, weekStart])
  @@index([shop, weekStart])
}

// Seasonal events / demand multipliers
model SeasonalEvent {
  id               String   @id @default(cuid())
  shop             String
  name             String   // "Eid ul Fitr", "Ramadan", "Back to School"
  startDate        DateTime
  endDate          DateTime
  impactMultiplier Float    @default(1.0) // 1.5 = 50% demand increase
  // Lead times stretch during peaks (customs, courier backlog). Applied to the
  // lead-time used for reorder points while the event is in the ordering window.
  leadTimeMultiplier Float  @default(1.0)
  // comma-separated Product ids this event affects (empty = all products)
  productIds       String   @default("")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, startDate])
}

model Forecast {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  forecastDate DateTime
  horizon      Int      // 30, 60, or 90 days
  // grossDemand = units that must physically SHIP (drives stock cover).
  grossDemand  Int
  // netDemand = units expected to be DELIVERED and kept (drives revenue, not stock).
  netDemand    Int
  // Units to actually BUY = shipUnits - sellable returns arriving in the horizon.
  procurementUnits Int   @default(0)
  expectedReturnsSellable Int @default(0)
  // 80% prediction interval around grossDemand, from holdout residuals.
  pi80Low      Int      @default(0)
  pi80High     Int      @default(0)
  // Which model produced this row: croston | sba | damped_trend | moving_average
  method       String   @default("moving_average")
  confidence   Float
  // AI enhancements
  seasonalityApplied Boolean @default(false)
  eventMultiplier    Float   @default(1.0)
  safetyStockUsed    Int     @default(0)
  createdAt    DateTime @default(now())

  @@unique([productId, horizon])
  @@index([shop])
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  shop                 String
  poNumber             String    @unique
  status               String    @default("draft") // draft | sent | received
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id])
  notes                String?
  totalCost            Float     @default(0)
  // When the PO was actually sent to the supplier. Lead time is measured
  // sentAt -> actualDeliveryDate, NOT createdAt (a draft may sit for weeks).
  sentAt               DateTime?
  // When the PO was actually emailed to the supplier, and to which address.
  // Deliberately separate from sentAt: a merchant may phone the supplier or hand over a
  // printout, so "sent" is a status the merchant sets, while this records a delivery the
  // app can actually vouch for.
  emailedAt            DateTime?
  emailedTo            String?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items PurchaseOrderItem[]

  @@index([shop])
  @@index([shop, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitCost        Float         @default(0)
}

model Alert {
  id        String   @id @default(cuid())
  shop      String
  type      String   // low_stock | stockout | dead_stock | return_rate_spike | lead_time_breach
  productId String
  message   String
  isRead    Boolean  @default(false)
  // Stable identity across runs (shop + type + productId). Lets the generator upsert
  // instead of delete-and-recreate, so read state and snoozes survive.
  dedupeKey String
  severity  String   @default("info") // critical | warning | info
  // Estimated revenue exposed by this condition — used to rank the digest.
  revenueAtRisk Float @default(0)
  snoozedUntil  DateTime?
  // Last time this alert was actually pushed to email/WhatsApp — prevents
  // re-notifying daily for the same standing condition.
  lastNotifiedAt DateTime?
  // Set when the condition clears; the row is kept for history.
  resolvedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, dedupeKey])
  @@index([shop, isRead])
  @@index([shop, type])
  @@index([shop, resolvedAt])
}


// Stock transfers between locations — draft → in-transit → received
model StockTransfer {
  id             String    @id @default(cuid())
  shop           String
  transferNumber String    @unique
  status         String    @default("draft") // draft | in-transit | received
  fromLocationId String
  toLocationId   String
  fromLocation   Location  @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation     Location  @relation("TransferTo", fields: [toLocationId], references: [id])
  notes          String?
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StockTransferItem[]

  @@index([shop])
  @@index([shop, status])
}

model StockTransferItem {
  id               String        @id @default(cuid())
  stockTransferId  String
  stockTransfer    StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantitySent     Int
  quantityReceived Int           @default(0)
}

// Returns-to-restock queue — one row per returned line item pulled from Courierify
// (shipment where isReturnReceived=true). The merchant resolves each into the physical
// stock: restock (adds units back via a StockAdjustment) or write-off (records damage).
model ReturnItem {
  id             String   @id @default(cuid())
  shop           String
  // Courierify shipment identity. (shipmentId, lineItemId) is the idempotency key —
  // lineItemId (Courierify ShipmentLineItem.id) is always present and unique per line,
  // so two null-SKU lines on one shipment stay distinct.
  shipmentId     String
  lineItemId     String
  shopifyOrderName String?
  // Product identity from Courierify. sku/shopifyVariantId are nullable (SKU-less products);
  // title/variantTitle are for display when the line can't be matched to a local Product.
  sku              String?
  shopifyVariantId String?
  title            String?
  variantTitle     String?
  productId      String?  // matched Product: by sku, then shopifyVariantId; null = unmatched
  product        Product? @relation(fields: [productId], references: [id])
  quantity       Int      @default(1)
  returnReceivedAt DateTime?
  reasonCategory String?  // from Courierify ReturnReason.category
  status         String   @default("pending") // pending | restocked | written_off
  // Delivery region, resolved from the Shopify order at ingest via OrderRegion.
  // RTO rates differ enormously between cities in COD markets, and a shop-wide
  // average hides which routes are actually losing money.
  city           String?
  // Carrier, when Courierify reports one. Optional by design: the returns contract
  // does not guarantee it, so this reads it opportunistically rather than requiring it.
  courier        String?
  locationId     String?  // where it was restocked (null until resolved)
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shipmentId, lineItemId])
  @@index([shop, status])
}

// A cycle-count session: pick a location, count what is physically there, review the
// variances, then post them as stock adjustments. This is the daily stockroom job the
// app was missing — ad-hoc "count_correction" adjustments existed, but not a count with
// a captured system snapshot to measure against and an all-or-nothing posting step.
model StockCount {
  id          String   @id @default(cuid())
  shop        String
  countNumber String   @unique
  // counting → review → posted, or cancelled from either of the first two.
  status      String   @default("counting")
  // The location being counted. A count is always scoped to one location so its snapshot
  // and its posted adjustments target the same per-location on-hand.
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  notes       String?
  // Whether the counter is shown the system quantity while entering counts. A blind count
  // (the default) hides it, so the number entered is what is on the shelf rather than a
  // nudge toward what the system expected.
  blind       Boolean  @default(true)
  postedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StockCountItem[]

  @@index([shop])
  @@index([shop, status])
}

// One product on a count. `snapshotQty` is the location's on-hand at the moment the line
// was added, captured so the variance the operator reviews is measured against a fixed
// figure rather than a stock level that keeps moving. `countedQty` is null until counted.
model StockCountItem {
  id          String     @id @default(cuid())
  stockCountId String
  stockCount  StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  snapshotQty Int
  countedQty  Int?
  note        String?

  // A product appears at most once per count — a second scan of the same SKU updates the
  // one line rather than creating a duplicate to reconcile.
  @@unique([stockCountId, productId])
  @@index([stockCountId])
}

// Webhook idempotency ledger. Shopify retries on any non-2xx or timeout; without this
// ORDERS_CREATE double-counts on every retry. Keyed on the X-Shopify-Webhook-Id header.
model WebhookEvent {
  id         String   @id // X-Shopify-Webhook-Id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([shop, topic])
  @@index([receivedAt])
}

// Forecast-vs-actual ledger. Every forecast writes a row due at forecastDate; a job
// fills in `actual` once that date passes, giving per-SKU MAPE and bias. Bias is what
// catches systematic under/over-buying (e.g. planning on net instead of gross demand).
model ForecastAccuracy {
  id          String    @id @default(cuid())
  shop        String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  horizon     Int
  forecastedAt DateTime @default(now())
  dueAt       DateTime  // forecastedAt + horizon days
  predicted   Int
  actual      Int?
  evaluatedAt DateTime?

  @@unique([productId, horizon, dueAt])
  @@index([shop, dueAt])
  @@index([shop, evaluatedAt])
}

// Delivery region per Shopify order, captured during order sync.
//
// This is the denominator for regional RTO analysis: returns can be attributed to a city
// (via shopifyOrderName), but without knowing how much was *shipped* to that city a
// return count says nothing. One row per order over the sync window.
model OrderRegion {
  id        String   @id @default(cuid())
  shop      String
  orderName String   // Shopify order name, e.g. "#1001" — the join key Courierify returns use
  city      String?
  province  String?
  country   String?
  units     Int      @default(0)
  isCod     Boolean  @default(false)
  // COD funnel facts. Demand is recorded at placement, but only dispatched units
  // actually consume stock — the gap between these is how much a placed-order demand
  // signal is inflated.
  isConfirmed  Boolean @default(false)
  isDispatched Boolean @default(false)
  isCancelled  Boolean @default(false)
  orderedAt DateTime

  @@unique([shop, orderName])
  @@index([shop, city])
  @@index([shop, orderedAt])
}

// Per-order SKU breakdown, captured during the Shopify order sync.
//
// SalesRecord aggregates demand per product per day and OrderRegion holds one row per
// order, so neither can answer "which SKUs were in order #2688". That question is exactly
// what turns a courier's order-level outcome into a per-SKU return rate, so the mapping is
// stored explicitly.
model OrderLineItem {
  id        String   @id @default(cuid())
  shop      String
  orderName String   // Shopify order name, e.g. "#2688" — the courier's join key
  productId String   // Shopify variant GID
  sku       String?
  quantity  Int
  orderedAt DateTime

  @@unique([shop, orderName, productId])
  @@index([shop, orderName])
  @@index([shop, productId])
  @@index([shop, orderedAt])
}

// Courier outcome for one shipment, keyed to a Shopify order.
//
// Populated from an order-level courier feed. This exists because the per-SKU courier
// endpoints depend on shipment line items carrying a SKU, which in practice they very
// often do not — leaving per-SKU RTO empty even for shops with thousands of returns.
// Order-level outcomes plus OrderLineItem reconstruct the same figure locally.
model OrderOutcome {
  id         String   @id @default(cuid())
  shop       String
  shipmentId String
  orderName  String
  // delivered | returned | in_transit | booked | ... (source vocabulary, passed through)
  status     String
  // Where the outcome came from. Shopify's own fulfilment tracking covers every shop
  // with no integration at all, so it is the base layer; a courier feed refines it.
  // "shopify" | "courierify"
  source     String   @default("courierify")
  courier    String?
  updatedAt  DateTime

  @@unique([shop, shipmentId])
  @@index([shop, orderName])
  @@index([shop, status])
  @@index([shop, updatedAt])
  @@index([shop, source])
}
